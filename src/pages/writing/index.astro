---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('writing', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Writing"
  description="Essays from Ian Gao on philosophy, politics, and policy — grounded in debate, research, and campaign work."
>
  <header class="page-head">
    <div class="wrap">
      <h1>Writing</h1>
      <p class="lede">Long-form thinking that doesn't fit on a debate flow. <a href="/rss.xml">RSS</a></p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      {posts.length === 0 ? (
        <p>Nothing published here yet — the first essays are in progress.</p>
      ) : (
        <ul class="posts">
          {posts.map((post) => (
            <li>
              <h2><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Layout>

<style>
  .page-head {
    padding-block: clamp(30px, 5vw, 46px) 0;
  }

  h1 {
    font-size: clamp(30px, 5vw, 42px);
    margin: 0 0 8px;
  }

  .page-head .lede {
    color: var(--muted);
    margin: 0;
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .posts li {
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
  }

  .posts li:first-child {
    padding-top: 0;
  }

  .posts li:last-child {
    border-bottom: 0;
  }

  .posts h2 {
    font-size: 21px;
    margin: 0 0 4px;
  }

  .posts h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  .posts h2 a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .posts p {
    margin: 0;
    color: var(--muted);
  }
</style>
