---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../lib/site';

const apCourses = [
  'AP European History',
  'AP Chinese Language and Culture',
  'AP English Language and Composition',
  'AP US History',
  'AP Calculus AB',
  'AP Physics 1',
];

const leadership = [
  {
    org: 'Justice For All',
    role: 'Co-founder and Vice President',
    dates: '2024 – present',
    body: 'A nonprofit promoting courtwatching among young people. We partnered with the San Jose Public Defender’s Office, collecting data that informed the office’s strategy for indigent clients, and evaluated the effectiveness of the Racial Justice Act. It now has 250+ interns across 5 states, 10 chapters nationally, and 1,000+ cases watched and recorded.',
  },
  {
    org: 'Rural Debate Initiative (RuDi)',
    role: 'Debate Coach',
    dates: 'Sep 2024 – present',
    body: 'I teach weekly speech and debate classes to a cohort of 10 middle and high school students at Jay Pritzker Academy in Cambodia, and have run online workshops for students in rural Pennsylvania, Cambodia, and Somaliland.',
  },
  {
    org: 'District 10 Youth Advisory Council',
    role: 'Youth Council Member',
    dates: 'Aug 2025 – present',
    body: 'Weekly meetings providing policy recommendations to San Jose City Council member George Casey. I helped organize events like YouthConnect to grow civic engagement among young people, and researched community issues and drafted policy resolutions.',
  },
];

/*
  External pages that mention Ian. Same pattern as src/data/beliefs.ts: the section renders only
  when there is something real to show, so the site never ships an empty press shelf announcing
  that other people write about him. Add `{ label, href }` once a URL is confirmed —
  the school debate team page and the school newspaper article are the two expected entries.
*/
const pressMentions: { label: string; href: string }[] = [];
---

<Layout
  title="About"
  description="More about Ian Gao — coursework at Leland High School, the nonprofit he co-founded, coaching, and the youth council he sits on."
>
  <header class="page-head">
    <div class="wrap">
      <h1>About</h1>
      <p class="lede">
        I'm Ian Gao ({SITE.legalName}), a senior at {SITE.school} in {SITE.locality}. Mandarin Chinese and English are
        both native languages for me, and my Spanish is conversational. Most of my time outside of class goes to
        public speaking and to research in history and the social sciences.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      {/*
        OPEN DECISION FOR IAN — the GPA/SAT line below is the most admissions-officer-only content
        on the site, and he wrote that his "target audience shouldn't be just AOs". It is kept for
        now because the goal forbids deleting a true accomplishment unilaterally. Three options:
        (a) keep as-is, (b) drop the scores and keep the AP course list, (c) drop the whole block.
        Raised with him rather than silently decided either way.
      */}
      <h2>School</h2>
      <p>
        Leland High School, 2023–present. 4.33 weighted GPA, 4.00 unweighted, 1540 SAT. I've scored a 5 on all six AP
        exams I've taken:
      </p>
      <ul class="plain-list">
        {apCourses.map((c) => (
          <li>{c}</li>
        ))}
      </ul>
      <p class="awards-line">
        I've also earned the National Spanish Exam Gold Medal (2024) and the NSDA Degree of Special Distinction.
      </p>
    </div>
  </section>

  <section id="leadership" class="section">
    <div class="wrap">
      <h2>Outside the team</h2>
      {leadership.map((item) => (
        <div class="entry">
          <h3>{item.org}</h3>
          <p class="meta entry-meta">{item.role} · {item.dates}</p>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  {pressMentions.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2>Elsewhere</h2>
        <ul class="plain-list">
          {pressMentions.map((p) => (
            <li><a href={p.href}>{p.label}</a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <p>
        <a href="/">Back to the homepage</a> · <a href={`mailto:${SITE.email}`}>Send me an email</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .page-head {
    padding-block: clamp(30px, 5vw, 46px) 0;
  }

  h1 {
    font-size: clamp(30px, 5vw, 42px);
    margin: 0 0 12px;
  }

  .entry {
    margin-bottom: 26px;
  }

  .entry:last-of-type {
    margin-bottom: 0;
  }

  .entry-meta {
    margin: 4px 0 8px;
  }

  .awards-line {
    margin-top: 16px;
  }
</style>
