---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { SITE } from '../lib/site';
import { personSchema } from '../lib/schema';
import { beliefs } from '../data/beliefs';

import portrait from '../assets/ian-portrait.jpg';
import natsPhoto from '../assets/ian-nationals.jpg';
// These two are "Ian talking on stage" / "Ian on stage 2" — speech-and-debate photos.
// Moved out of Theatre and into Speech and Debate per Ian's 7/27 notes.
import speaking1 from '../assets/ian-stage-2.jpg';
import speaking2 from '../assets/ian-stage-1.png';
import debatingPhoto from '../assets/ian-debating.jpg';
import ucsbPhoto from '../assets/ian-ucsb-research.png';
import mahanPhoto from '../assets/ian-mahan-campaign.png';
// Ian's "Ian with Matt mahan" — the photo he asked to sit alongside the one already there.
import mahanWithIan from '../assets/ian-mahan-with.jpg';
// "Ian theater 1-6", kept in Ian's own numbering. He numbered them without naming productions,
// so they run as rows rather than being attributed to a specific show — see note above `productions`.
import theatre01 from '../assets/theatre/theatre-01.jpg';
import theatre02 from '../assets/theatre/theatre-02.jpg';
import theatre03 from '../assets/theatre/theatre-03.jpg';
import theatre04 from '../assets/theatre/theatre-04.jpg';
import theatre05 from '../assets/theatre/theatre-05.jpg';
import theatre06 from '../assets/theatre/theatre-06.jpg';

const debateResults = [
  { event: 'NSDA Nationals, LD', result: '19th in the nation', year: '2026' },
  { event: 'CA State Championships, LD', result: 'Top 30', year: '2026' },
  { event: 'Philhistorian Invitational, Open LD', result: 'Champion', year: '2024' },
  { event: 'NSDA Last Chance Qualifier, Open LD', result: 'First seed, undefeated', year: '2025 & 2026' },
  { event: 'Stephen Stewart Invitational, Open LD', result: 'Quarterfinals', year: '2025' },
];

const debateBullets = [
  // Ranking figures deliberately left to the intro paragraph rather than repeated here; see round-2 submission.
  'I lead a nationally competitive team of 200 students, taking them to regional and national tournaments as the best public-school program in our district.',
  'I manage registration and communication for all judges, coaches, and tournaments, and oversee our ~20-person student leadership team of VPs and Chairs, heading biweekly leadership meetings and holding the team accountable.',
  'I headed and executed a complete overhaul of the team — restructuring from 2 to 5 periods, building a tailored roster by event, and facilitating the transition to a new head coach.',
  'As Captain of LD this past year, I wrote lesson plans and assignments for weekly meetings, mentored novice debaters, and led bimonthly topic-research sessions on issues like plea bargaining, the living wage, military intervention, and artificial general intelligence for my team of 20 debaters.',
];

const research = [
  {
    org: 'Cambridge Center of International Research',
    tag: 'CCIR',
    mentor: 'Mentored by Oxford Professor Dr. Othon Anastasakis',
    points: [
      'Authored a 15,000-word original research paper, “Bosnia and Herzegovina and the Limits of International State-Building: How Stable Is the Post-Dayton Order?”',
      'Analyzed the impact of the Dayton Peace Agreement on Bosnia and Herzegovina’s political institutions, with a focus on ethnic power-sharing, governance, and democratic stability.',
      'Presented twice at the CCIR Research Symposium.',
    ],
  },
  {
    org: 'UC Santa Barbara — Summer Research Academies',
    tag: 'Track 11: Policy Puzzle · June–July 2025',
    mentor: 'Mentored by PhD candidate Travis Candeias',
    points: [
      'Earned an A in INT 93LS — Applied Research Methods for Policy Analysis, covering quasi-experimental design and latent-variable modeling for policy evaluation.',
      'Co-authored “A Model Policing Agency: Analyzing the Impact of the Collaborative Reform Initiative on Use of Force in San Francisco.”',
      'Used R to analyze large SFPD use-of-force datasets from 2018–2023, evaluating the Collaborative Reform Initiative’s effectiveness by incident severity and demographics.',
    ],
  },
  {
    org: 'UC Santa Cruz — Science Internship Program',
    tag: 'PHI-03 · June 2026–present',
    mentor: 'Mentored by philosophy PhD candidate Terri Preszle',
    points: [
      '“What is Love? — A Philosophical Inquiry.”',
      'Close reading and annotation of ancient and contemporary philosophers on the many theories of love, contributing to my mentor’s doctoral thesis.',
    ],
  },
];

const campaigns = [
  {
    name: 'Matt Mahan for Governor of California',
    role: 'Campaign Intern & Phonebank Lead',
    dates: 'Feb 2026 – Jun 2026',
    points: [
      'Led weekly phone-banking sessions with 20+ volunteers, training them to reach tens of thousands of voters.',
      'Helped organize town halls, GOTV rallies, meet-and-greets, and an election watch party across the Bay Area.',
      'Ran voter outreach — recruiting and managing volunteers for canvassing and literature drops across thousands of homes.',
    ],
  },
  {
    name: 'Evan Low for Congress',
    role: 'Campaign Intern',
    dates: 'Sep 2024 – Nov 2024',
    points: [
      'Phone banking, canvassing, and literature drops (~200 houses door-to-door).',
      'Weekly team meetings on campaign strategy and event planning.',
    ],
  },
];

/*
  `photo` attaches a still to a specific production. Ian supplied "Ian theater 1-6" numbered but
  WITHOUT naming which show each is from, so they run as unattributed rows (1-3 above the list,
  4-6 below it) rather than being guessed into rows. Once he says which production each belongs to,
  set `photo: theatre02` (etc.) on that entry — the row already reserves the column, no CSS change.
*/
interface Production {
  show: string;
  season: string;
  role: string;
  supporting?: string;
  lead: boolean;
  photo?: ImageMetadata;
}

const productions: Production[] = [
  { show: 'Clue: On Stage', season: 'Spring 2026', role: 'Colonel Mustard', lead: true },
  { show: 'Chicago', season: 'Winter 2025', role: 'Set Crew Lead', lead: false },
  { show: 'Mamma Mia', season: 'Spring 2025', role: 'Sky', lead: false },
  { show: 'The Importance of Being Earnest', season: 'Winter 2024', role: 'Algernon Moncrieff', lead: true },
  { show: 'Mean Girls', season: 'Spring 2024', role: 'Kevin G / Ensemble', lead: false },
  {
    show: 'The Laramie Project',
    season: 'Winter 2023',
    role: 'Greg Pierotti, Rulon Stacey',
    supporting: 'Aaron McKinney, Shadow & The Bailiff',
    lead: true,
  },
];
---

<Layout
  title="Ian Gao"
  description="The personal site of Ian Gao, a senior at Leland High School in San Jose — debate, research in policy and philosophy, campaign work, theatre, and writing."
  homepage
  structuredData={personSchema()}
>
  <!-- HERO — ticker, "THE STUDY OF" eyebrow and both buttons removed per Ian's 7/27 notes -->
  <header class="hero">
    <div class="wrap-wide hero-inner">
      <div class="hero-text">
        <h1>Ian Gao</h1>
        <p class="hero-tagline">philosophy · politics · policy</p>
      </div>
      <Image
        class="hero-photo"
        src={portrait}
        alt="Ian Gao wearing headphones at a museum exhibit"
        widths={[280, 560]}
        sizes="clamp(240px, 24vw, 280px)"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </header>

  <!-- WHO I AM -->
  <section class="section">
    <div class="wrap">
      <h2 class="sr-only">About me</h2>
      {/* Verbatim from Ian's "changes 7/27" bio. Do not paraphrase without asking him. */}
      <p class="lede">Hi! I'm Ian Gao, a senior at Leland High School.</p>
      <p>
        I'm the President of Debate at Leland Speech and Debate, a program of 200+ students ranked third in
        California and tenth in the nation. This summer I competed at the 2026 National Speech and Debate
        Tournament, where I placed 19th in the nation in Lincoln-Douglas Debate.
      </p>
      <p>
        I'm also a student researcher at UC Santa Barbara in policy analysis, where I evaluated the effects of the
        Collaborative Reform initiative on Use-of-Force Incidents in San Francisco, and at UC Santa Cruz in
        philosophy, where I closely annotated contemporary philosophers on the many theories of love, contributing
        to my mentor's doctoral thesis.
      </p>
      <p>
        Outside of research and debate, I enjoy acting as a cast member in Leland Theatre, interning for political
        campaigns I believe in, increasing civic engagement among young people through courtwatching, playing
        basketball, and learning a few songs on the guitar!
      </p>
    </div>
  </section>

  {beliefs.length > 0 && (
    <section id="beliefs" class="section">
      <div class="wrap">
        <h2>What I believe</h2>
        <div class="beliefs">
          {beliefs.map((b) => (
            <div class="belief">
              <p class="belief-claim">{b.claim}</p>
              {b.body && <p class="belief-body">{b.body}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- SPEECH AND DEBATE -->
  <section id="debate" class="section">
    <div class="wrap">
      <h2>Speech and Debate</h2>
      <p>
        I compete in Lincoln-Douglas and Policy Debate, Duo Interpretation, and Extemporaneous Speaking. This past
        year I was Captain of Lincoln-Douglas; I'm now President of Debate at Leland Speech and Debate.
      </p>

      <figure class="photo-pair-figure">
        <div class="photo-pair">
          <Image src={speaking1} alt="Ian speaking at a podium on stage" widths={[340, 680]} sizes="(min-width: 640px) 340px, 90vw" loading="lazy" />
          <Image src={speaking2} alt="Ian speaking on stage, gesturing mid-sentence" widths={[340, 680]} sizes="(min-width: 640px) 340px, 90vw" loading="lazy" />
        </div>
        <figcaption class="meta">At the 2025 Leland Speech and Debate Performance Night.</figcaption>
      </figure>

      <h3 class="sub">Results</h3>
      <table class="results">
        <thead>
          <tr>
            <th scope="col">Tournament</th>
            <th scope="col">Result</th>
            <th scope="col">Year</th>
          </tr>
        </thead>
        <tbody>
          {debateResults.map((r) => (
            <tr>
              <td>{r.event}</td>
              <td>{r.result}</td>
              <td class="yr">{r.year}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="photo-pair">
        <figure>
          <Image src={natsPhoto} alt="Ian at the 2026 NSDA National Speech and Debate Tournament" widths={[340, 680]} sizes="(min-width: 640px) 340px, 90vw" loading="lazy" />
          <figcaption class="meta">At the 2026 NSDA National Tournament.</figcaption>
        </figure>
        <figure>
          <Image src={debatingPhoto} alt="Ian speaking from a laptop stand in a debate round, with a judge seated in front of him" widths={[340, 680]} sizes="(min-width: 640px) 340px, 90vw" loading="lazy" />
          <figcaption class="meta">Mid-round.</figcaption>
        </figure>
      </div>

      <h3 class="sub">As President of Debate</h3>
      {/* Sized to match the body copy above. This reverses the earlier "[Enlarge by 2 times]"
          note in Ian's doc — superseded by a later direct instruction; don't re-enlarge. */}
      <ul class="plain-list">
        {debateBullets.map((b) => (
          <li>{b}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- RESEARCH -->
  <section id="research" class="section">
    <div class="wrap">
      <h2>Research</h2>
      {research.map((r) => (
        <div class="entry">
          <h3>{r.org}</h3>
          <p class="meta entry-meta">{r.tag} · {r.mentor}</p>
          <ul class="plain-list">
            {r.points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </div>
      ))}
      <figure class="photo-single">
        <Image src={ucsbPhoto} alt="Ian presenting an analysis of SFPD use-of-force data at UC Santa Barbara" widths={[340, 680]} sizes="(min-width: 640px) 340px, 90vw" loading="lazy" />
        <figcaption class="meta">Presenting our SFPD use-of-force analysis at UC Santa Barbara.</figcaption>
      </figure>
    </div>
  </section>

  <!-- CAMPAIGNING -->
  <section id="campaigning" class="section">
    <div class="wrap">
      <h2>Campaigning</h2>
      {/* "fitting and adjusting it with the photo already there" — the two have very different
          aspect ratios, so the pair is height-matched and cropped to centre rather than ragged. */}
      <div class="photo-pair even">
        <figure>
          <Image src={mahanPhoto} alt="Ian on the Matt Mahan for Governor campaign" widths={[340, 680]} sizes="(min-width: 640px) 340px, 90vw" loading="lazy" />
        </figure>
        <figure>
          <Image src={mahanWithIan} alt="Ian with Matt Mahan and fellow campaign volunteers" widths={[340, 680]} sizes="(min-width: 640px) 340px, 90vw" loading="lazy" />
        </figure>
      </div>
      {campaigns.map((c) => (
        <div class="entry">
          <h3>{c.name}</h3>
          <p class="meta entry-meta">{c.role} · {c.dates}</p>
          <ul class="plain-list">
            {c.points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- THEATRE -->
  <section id="theatre" class="section">
    <div class="wrap">
      <h2>Theatre</h2>
      <p>I've been part of six productions with Leland Theatre since 2023.</p>
      <div class="photo-row">
        <figure><Image src={theatre01} alt="Ian on stage in a red patterned dressing gown, in scene with another actor" widths={[300, 600]} sizes="(min-width: 700px) 240px, 90vw" loading="lazy" /></figure>
        <figure><Image src={theatre02} alt="Ian mid-scene with the ensemble on a chequered stage floor" widths={[300, 600]} sizes="(min-width: 700px) 240px, 90vw" loading="lazy" /></figure>
        <figure><Image src={theatre03} alt="Ian in scene with another actor on a set decorated with blossom" widths={[300, 600]} sizes="(min-width: 700px) 240px, 90vw" loading="lazy" /></figure>
      </div>
      <ol class="productions">
        {productions.map((p) => (
          <li>
            {p.photo && (
              <Image class="prod-photo" src={p.photo} alt={`Ian as ${p.role} in ${p.show}`} widths={[120, 240]} sizes="120px" loading="lazy" />
            )}
            <div class="prod-text">
              <div class="prod-head">
                <h3 class="prod-show"><em>{p.show}</em></h3>
                <span class="meta prod-season">{p.season}</span>
              </div>
              <p class="prod-role">
                {p.lead ? <strong>{p.role}</strong> : p.role}
                {p.supporting && <span class="prod-supporting"> · also {p.supporting}</span>}
              </p>
            </div>
          </li>
        ))}
      </ol>
      <div class="photo-row">
        <figure><Image src={theatre04} alt="Ian performing on stage under coloured lights" widths={[300, 600]} sizes="(min-width: 700px) 240px, 90vw" loading="lazy" /></figure>
        <figure><Image src={theatre05} alt="Ian and two castmates in period costume on stage" widths={[300, 600]} sizes="(min-width: 700px) 240px, 90vw" loading="lazy" /></figure>
        <figure><Image src={theatre06} alt="Ian and a castmate in metallic gold and iridescent costumes in front of a red curtain" widths={[300, 600]} sizes="(min-width: 700px) 240px, 90vw" loading="lazy" /></figure>
      </div>
      <p><a href="https://youtu.be/_pUo7QA8DPk" rel="noopener">Watch some of my scenes! ↗</a></p>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="section">
    <div class="wrap">
      <h2>Get in touch</h2>
      <p>
        The best way to reach me is a short email! — <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: clamp(34px, 6vw, 60px);
  }

  .hero-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }

  .hero-text {
    flex: 1;
    min-width: 220px;
  }

  h1 {
    font-size: clamp(38px, 7vw, 58px);
    line-height: 1.05;
    margin: 0;
  }

  .hero-tagline {
    font-style: italic;
    color: var(--muted);
    font-size: 19px;
    margin: 10px 0 0;
  }

  /* Enlarged per Ian's "Enlarge profile pic/take a different one" note. The photo swap to
     "ian main picture" is still blocked on that file. */
  .hero :global(.hero-photo) {
    width: clamp(240px, 24vw, 280px);
    height: auto;
    border-radius: 3px;
  }

  .sub {
    margin: 32px 0 12px;
    font-size: 17px;
    color: var(--muted);
    font-weight: 600;
  }

  .entry {
    margin-bottom: 30px;
  }

  .entry:last-of-type {
    margin-bottom: 0;
  }

  .entry-meta {
    margin: 4px 0 10px;
  }

  .results {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
  }

  .results th {
    font-family: var(--font-meta);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-align: left;
    padding: 0 10px 6px 0;
    border-bottom: 1px solid var(--rule);
  }

  .results td {
    padding: 9px 10px 9px 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }

  .results tr:last-child td {
    border-bottom: 0;
  }

  .results .yr {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
    padding-right: 0;
  }

  .photo-pair {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin: 22px 0;
  }

  @media (min-width: 560px) {
    .photo-pair {
      grid-template-columns: 1fr 1fr;
    }
  }

  .photo-pair figure {
    margin: 0;
  }

  .photo-pair-figure {
    margin: 22px 0;
  }

  .photo-pair-figure .photo-pair {
    margin: 0;
  }

  .photo-pair figcaption {
    margin-top: 7px;
  }

  .photo-pair-figure > figcaption {
    margin-top: 8px;
  }

  .photo-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin: 22px 0 26px;
  }

  @media (min-width: 700px) {
    .photo-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .photo-row figure {
    margin: 0;
  }

  .photo-row :global(img) {
    width: 100%;
    height: 260px;
    object-fit: cover;
    object-position: center top;
    border-radius: 3px;
  }

  .photo-pair.even :global(img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
  }

  .photo-pair :global(img),
  .photo-single :global(img) {
    width: 100%;
    height: auto;
    border-radius: 3px;
  }

  .photo-single {
    margin: 24px 0 0;
    max-width: 340px;
  }

  .photo-single figcaption {
    margin-top: 7px;
  }

  .productions {
    list-style: none;
    margin: 22px 0;
    padding: 0;
  }

  /* Grid, not flex: the 120px photo column is reserved on every row, so rows stay aligned
     whether or not a given production has a photo yet. Ian's `ian theater 1`-`6` can land one
     at a time without the list going ragged. Column collapses to 0 only if no row has a photo. */
  .productions {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 16px;
  }

  .productions li {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    align-items: start;
    padding: 14px 0;
    border-top: 1px solid var(--rule);
  }

  .prod-text {
    grid-column: 2;
    min-width: 0;
  }

  /* Subgrid is Baseline (Sept 2023) but degrades to a ragged auto track without this. */
  @supports not (grid-template-columns: subgrid) {
    .productions {
      display: block;
    }

    .productions li {
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }

    .prod-text {
      flex: 1;
      min-width: 0;
    }
  }

  .productions :global(.prod-photo) {
    grid-column: 1;
    width: 120px;
    height: auto;
    border-radius: 3px;
  }

  .productions li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .prod-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    flex-wrap: wrap;
  }

  .prod-show {
    font-size: 19px;
    font-weight: 600;
  }

  .prod-season {
    white-space: nowrap;
  }

  .prod-role {
    margin: 3px 0 0;
    font-size: 17px;
    color: var(--muted);
  }

  .prod-role strong {
    color: var(--ink);
    font-weight: 600;
  }

  .prod-supporting {
    font-size: 15px;
  }

  .beliefs {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .belief-claim {
    font-size: 20px;
    margin: 0 0 6px;
  }

  .belief-body {
    margin: 0;
    color: var(--muted);
  }
</style>
