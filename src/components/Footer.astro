---
import { SITE } from '../lib/site';
---

<footer>
  <div class="wrap-wide inner">
    {/* Kept to name / legal name / school / locality — the entity-consistency fields the spec
        actually needs. The rank-and-campaign roll-call that used to sit here read as a résumé
        signature stamped under every page, including the photo page. */}
    <p class="meta">Ian Gao ({SITE.legalName}) · {SITE.school}, {SITE.locality}</p>
    <p class="meta">
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a> · <a href="/activities/">Activities</a> · <a href="/about/">About</a>
    </p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--rule);
    background: var(--paper-2);
  }

  .inner {
    padding-block: 28px 34px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .inner p {
    margin: 0;
    max-width: 70ch;
  }
</style>
