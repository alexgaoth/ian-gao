---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import g01 from '../assets/gallery/gallery-01.jpg';
import g02 from '../assets/gallery/gallery-02.jpg';
import g03 from '../assets/gallery/gallery-03.jpg';
import g04 from '../assets/gallery/gallery-04.jpg';
import g05 from '../assets/gallery/gallery-05.jpg';
import g06 from '../assets/gallery/gallery-06.jpg';
import g07 from '../assets/gallery/gallery-07.jpg';
import g08 from '../assets/gallery/gallery-08.jpg';
import g09 from '../assets/gallery/gallery-09.jpg';
import g10 from '../assets/gallery/gallery-10.jpg';
import g11 from '../assets/gallery/gallery-11.jpg';
import g12 from '../assets/gallery/gallery-12.jpg';
import g13 from '../assets/gallery/gallery-13.jpg';

/*
  Captions are Ian's to write — he noted "I'll add small subtitles to each picture later".
  `caption` is left empty on purpose rather than filled with invented text; the markup
  renders the slot only when there is something to put in it.

  `alt` is written from what is actually visible in each photo (required for accessibility),
  and deliberately claims nothing beyond that.

  All 13 of Ian's gallery photos are wired in. Note gallery 8 and gallery 9 each arrived as two
  different images (a .jpg and a .heic; and a duplicate filename), so the numbering here runs 1-13.
*/
const photos = [
  { src: g12, alt: 'Ian in a suit and tie, photographed in a mirror', caption: '' },
  { src: g09, alt: 'Ian standing outside the Superior Court Hall of Justice', caption: '' },
  { src: g03, alt: 'Ian with Matt Mahan and fellow campaign volunteers', caption: '' },
  { src: g13, alt: 'Ian and a friend with trays of food at a McDonald\u2019s', caption: '' },
  { src: g04, alt: 'Ian and a friend at an NBA game, with LeBron James circled far down on the court', caption: '' },
  { src: g05, alt: 'Ian sitting inside a large sand sculpture on a beach', caption: '' },
  { src: g06, alt: 'Ian in a baseball cap looking out at boats on the water at night', caption: '' },
  { src: g07, alt: 'Ian in a red robe and teal tie in costume, wearing a stage mic', caption: '' },
  { src: g08, alt: 'Ian backstage in costume with a stage mic', caption: '' },
  { src: g10, alt: 'Ian in costume wearing a laurel wreath and a patterned jacket', caption: '' },
  { src: g11, alt: 'Ian in a blue robe costume with a false white moustache', caption: '' },
  { src: g02, alt: 'A young child climbing on a large whale sculpture in a courtyard', caption: '' },
  { src: g01, alt: 'Ian as a toddler in a blue cardigan', caption: '' },
];
---

<Layout
  title="Photos"
  description="Photos from Ian Gao's life outside of school — campaign work, courtwatching, theatre, friends, and one very distant celebrity sighting."
>
  <header class="page-head">
    <div class="wrap">
      <h1>Photos</h1>
      <p class="lede">A few pictures, in no particular order.</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap-wide">
      <ul class="grid">
        {photos.map((photo) => (
          <li>
            <figure>
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[320, 640, 900]}
                sizes="(min-width: 900px) 320px, (min-width: 560px) 45vw, 90vw"
                loading="lazy"
              />
              {photo.caption && <figcaption class="meta">{photo.caption}</figcaption>}
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .page-head {
    padding-block: clamp(30px, 5vw, 46px) 0;
  }

  h1 {
    font-size: clamp(30px, 5vw, 42px);
    margin: 0 0 8px;
  }

  .page-head .lede {
    color: var(--muted);
    margin: 0;
  }

  /* Masonry-style columns: keeps every photo uncropped and avoids ragged row bottoms. */
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 1;
    column-gap: 20px;
  }

  @media (min-width: 560px) {
    .grid {
      columns: 2;
    }
  }

  @media (min-width: 900px) {
    .grid {
      columns: 3;
    }
  }

  .grid li {
    break-inside: avoid;
    margin-bottom: 20px;
  }

  figure {
    margin: 0;
  }

  figure :global(img) {
    width: 100%;
    height: auto;
    border-radius: 3px;
  }

  figcaption {
    margin-top: 7px;
  }
</style>
