---
import Layout from '../layouts/Layout.astro';

const activities = [
  {
    name: 'Speech and Debate',
    dates: 'Aug 2024 – present',
    body: 'President of Leland Speech and Debate; Captain of Lincoln-Douglas in 2025–26. I compete in LD, Policy, Duo Interpretation, and Extemporaneous Speaking, and placed 19th in the nation at NSDA Nationals in 2026.',
    href: '/#debate',
  },
  {
    name: 'Research',
    dates: '2025 – present',
    body: 'Research at the Cambridge Center of International Research, UC Santa Barbara, and UC Santa Cruz — international relations, criminal-justice policy, and philosophy.',
    href: '/#research',
  },
  {
    name: 'Campaigning',
    dates: 'Sep 2024 – Jun 2026',
    body: 'Campaign work for Matt Mahan (Governor of California) and Evan Low (Congress) — phone banking, canvassing, and volunteer coordination.',
    href: '/#campaigning',
  },
  {
    name: 'Theatre',
    dates: 'Aug 2023 – present',
    body: 'Six productions with Leland Theatre, including Algernon Moncrieff in The Importance of Being Earnest and Colonel Mustard in Clue: On Stage.',
    href: '/#theatre',
  },
  {
    name: 'Justice For All',
    dates: '2024 – present',
    body: 'Co-founder and Vice President of a nonprofit promoting courtwatching among young people, partnered with the San Jose Public Defender’s Office. 250+ interns across 5 states, 10 chapters, 1,000+ cases watched.',
    href: '/about/#leadership',
  },
  {
    name: 'Rural Debate Initiative (RuDi)',
    dates: 'Sep 2024 – present',
    body: 'Debate coach teaching weekly classes at Jay Pritzker Academy in Cambodia, plus workshops for students in rural Pennsylvania and Somaliland.',
    href: '/about/#leadership',
  },
  {
    name: 'District 10 Youth Advisory Council',
    dates: 'Aug 2025 – present',
    body: 'Youth council member providing policy recommendations to San Jose City Council member George Casey; helped organize YouthConnect civic-engagement events.',
    href: '/about/#leadership',
  },
  {
    name: 'Track & Field / Cross Country',
    dates: 'Jan 2025 – present',
    body: 'Long jump, high jump, and cross country.',
  },
];
---

<Layout
  title="Activities"
  description="A full list of what Ian Gao does outside class — debate, research, campaigns, theatre, track, coaching, and a courtwatching nonprofit."
>
  <header class="page-head">
    <div class="wrap">
      <h1>Activities</h1>
      <p class="lede">What I spend my time on outside of class.</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      {activities.map((a) => (
        <div class="entry">
          <div class="entry-head">
            <h2>{a.name}</h2>
            <span class="meta">{a.dates}</span>
          </div>
          <p>{a.body}</p>
          {a.href && <p class="more"><a href={a.href}>More →</a></p>}
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-head {
    padding-block: clamp(30px, 5vw, 46px) 0;
  }

  h1 {
    font-size: clamp(30px, 5vw, 42px);
    margin: 0 0 8px;
  }

  .page-head .lede {
    color: var(--muted);
    margin: 0;
  }

  .entry {
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
  }

  .entry:first-child {
    padding-top: 0;
  }

  .entry:last-child {
    border-bottom: 0;
  }

  .entry-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    flex-wrap: wrap;
  }

  .entry-head h2 {
    font-size: 20px;
    margin: 0;
  }

  .entry p {
    margin: 6px 0 0;
  }

  .more {
    font-family: var(--font-meta);
    font-size: 14px;
  }
</style>
